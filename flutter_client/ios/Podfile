# The path to the xcconfig file generated by `flutter build` / `flutter pub get`
flutter_xcconfig = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
unless File.exist?(flutter_xcconfig)
  raise 'Generated.xcconfig must exist. If you\'re running pod install manually, make sure "flutter pub get" is executed first'
end

File.open(flutter_xcconfig, 'r') do |file|
  file.each_line do |line|
    line.strip!
    next if line.empty?
    next if line.start_with?('#') || line.start_with?('//')
    if line.start_with?('FLUTTER_ROOT=')
      flutter_root = line.split('=').last
      require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper.rb'), flutter_root)
      break
    end
  end
end

# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends usage stats. In order to automate CI/CD you may want to disable it
# env['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
end
