<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header Section -->
    <TextView
        android:id="@+id/focus_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯 FOCUS_MISSION"
        android:textColor="#FF9F43"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05" />

    <!-- Done Action Button -->
    <TextView
        android:id="@+id/btn_complete_mission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:text="[✓ DONE]"
        android:textColor="#22C55E"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Big Countdown text -->
    <TextView
        android:id="@+id/focus_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/focus_header"
        android:layout_marginTop="12dp"
        android:text="IN 2 DAYS"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed" />

    <!-- Event Title / Context -->
    <TextView
        android:id="@+id/focus_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/focus_time"
        android:layout_marginTop="4dp"
        android:text="Next-Gen AI Orchestration Workshop"
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        android:fontFamily="sans-serif-light"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1" />

    <!-- Footer System Status -->
    <TextView
        android:id="@+id/focus_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="CORTEX_ACTIVE"
        android:textColor="#22C55E"
        android:textSize="9sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:letterSpacing="0.1" />
</RelativeLayout>
