<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header Section -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 BRAIN_SPARK"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="🔄"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp"
            android:contentDescription="Refresh Insight" />
    </RelativeLayout>

    <!-- Thought Text Area -->
    <TextView
        android:id="@+id/thought_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:layout_above="@id/bottom_divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Select 'Sync Vault' or tap refresh to load insights from your ingested knowledge."
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-light"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.2" />

    <!-- Bottom Divider -->
    <ImageView
        android:id="@+id/bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/action_bar"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_divider" />

    <!-- Bottom Actions Grid -->
    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Voice Memo Target -->
        <LinearLayout
            android:id="@+id/btn_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Record"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="@color/widget_divider" />

        <!-- Clipboard Ingest Target -->
        <LinearLayout
            android:id="@+id/btn_clipboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Ingest Link"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="@color/widget_divider" />

        <!-- Scratchpad Quick Note Target -->
        <LinearLayout
            android:id="@+id/btn_scratchpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ Scratchpad"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
