<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_pill"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:gravity="center_vertical">

    <!-- Search Area Target -->
    <LinearLayout
        android:id="@+id/search_input_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/btn_voice_search"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search your Brain..."
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

    <!-- Voice Search Button Target -->
    <LinearLayout
        android:id="@+id/btn_voice_search"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:gravity="center">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️"
            android:textColor="@color/widget_accent"
            android:textSize="16sp" />
    </LinearLayout>
</RelativeLayout>
