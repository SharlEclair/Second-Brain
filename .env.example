# ── Required ──────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_google_ai_studio_key_here"

# ── Vault Paths ────────────────────────────────────────────────────────────────
# Path to your Obsidian Vault's inbox folder (where new notes land)
OBSIDIAN_INBOX_PATH="C:/Path/To/Your/Obsidian/Vault/Inbox"
# Path to the project's own vault folder (defaults to ./vault if unset)
PROJECT_VAULT_PATH="./vault"

# ── Optional Integrations ──────────────────────────────────────────────────────
# Google Maps geocoding (for Spot-to-Visit location extraction)
GOOGLE_MAPS_API_KEY="your_google_maps_key_here"

# Redis broker URL for Celery task queue (required for X-Queue ingestion mode)
REDIS_URL="redis://localhost:6379/0"

# ── Ngrok Tunnel (for mobile access outside your local network) ────────────────
# Do NOT put your authtoken here. Set it as a shell environment variable instead:
#   export NGROK_AUTHTOKEN="your_token_here"   (macOS/Linux)
#   $env:NGROK_AUTHTOKEN="your_token_here"     (Windows PowerShell)
# The ngrok.yml file reads ${NGROK_AUTHTOKEN} automatically.
